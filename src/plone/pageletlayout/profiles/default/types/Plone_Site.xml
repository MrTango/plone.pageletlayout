<?xml version="1.0" encoding="UTF-8"?>
<!-- The front page renders through the shared folderish listing views by
     default (ticket 12): listing_view is the default, the other four formats
     stay selectable in the Display menu. The classic views stay addressable
     (view_methods purge=False). -->
<object name="Plone Site" meta_type="Dexterity FTI" purge="False">
  <property name="default_view">listing_view</property>
  <property name="view_methods" purge="False">
    <element value="listing_view" />
    <element value="summary_view" />
    <element value="tabular_view" />
    <element value="full_view" />
    <element value="album_view" />
  </property>
</object>
