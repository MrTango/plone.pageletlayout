<?xml version="1.0" encoding="UTF-8"?>
<object>
  <!-- Where each layout element sits inside the stock manager its slot
       assignment names (registry.xml, plone.pageletlayout.slot_assignments):
       the place classic Plone renders the stock viewlet it replaces. Anchors,
       not restated orders: Plone owns each manager's sequence, and this file
       only inserts our names into it, idempotently. -->
  <order manager="plone.portalheader" skinname="Plone Default">
    <viewlet name="plone.pageletlayout.logo" insert-before="*" />
    <viewlet name="plone.pageletlayout.anontools"
             insert-after="plone.pageletlayout.logo" />
    <viewlet name="plone.pageletlayout.searchbox"
             insert-after="plone.searchbox" />
  </order>
  <order manager="plone.mainnavigation" skinname="Plone Default">
    <viewlet name="plone.pageletlayout.globalnav" insert-before="*" />
  </order>
  <order manager="plone.abovecontent" skinname="Plone Default">
    <viewlet name="plone.pageletlayout.breadcrumbs" insert-before="*" />
  </order>
  <order manager="plone.abovecontenttitle" skinname="Plone Default">
    <viewlet name="plone.pageletlayout.socialtags" insert-before="*" />
  </order>
  <!-- First in plone.abovecontentbody is where the frame used to print the
       content header itself: at the top of article#content. -->
  <order manager="plone.abovecontentbody" skinname="Plone Default">
    <viewlet name="plone.pageletlayout.contentheader" insert-before="*" />
  </order>
  <order manager="plone.belowcontenttitle" skinname="Plone Default">
    <viewlet name="plone.pageletlayout.byline" insert-before="*" />
  </order>
  <order manager="plone.portalfooter" skinname="Plone Default">
    <viewlet name="plone.pageletlayout.copyright"
             insert-after="plone.site_actions" />
    <viewlet name="plone.pageletlayout.colophon"
             insert-after="plone.pageletlayout.copyright" />
    <viewlet name="plone.pageletlayout.siteactions"
             insert-after="plone.pageletlayout.colophon" />
  </order>

  <!-- ====================================================================
       The stock viewlets this package reimplements as its own elements.
       Rendering both in the same slot would show logo, breadcrumbs, byline,
       colophon and site actions TWICE.

       Configuration, not a code-level exemption: an integrator who prefers
       the stock viewlet unhides it here and hides our element instead.
       Every entry below has a counterpart in slots.DEFAULT_ASSIGNMENTS —
       nothing is hidden that this package does not genuinely replace.

       Note what is NOT hidden: plone.membertools (IPortalHeader) is the
       logged-in half of the personal bar and has no element of ours —
       AnontoolsChromePagelet covers the anonymous half only — so it stays
       visible in the portalheader slot. (It renders nothing while the
       toolbar is on; its template is gated on the toolbar being hidden.)

       Nor is plone.footer (IPortalFooter), which renders the footer PORTLET
       manager — content an integrator assigns, not chrome we reimplement.
       Plone's own default assignments there happen to be a colophon and a
       site-actions portlet, so a site keeping them sees those alongside our
       colophon/siteactions elements. Portlet assignments are site data and
       a GS viewlets.xml cannot touch them; removing the two default
       assignments (or hiding our two elements) is the integrator's call.
       ==================================================================== -->

  <!-- plone.pageletlayout.logo / .anontools / .searchbox -->
  <hidden manager="plone.portalheader" skinname="Plone Default">
    <viewlet name="plone.logo" />
    <viewlet name="plone.anontools" />
    <viewlet name="plone.searchbox" />
  </hidden>

  <!-- plone.pageletlayout.globalnav -->
  <hidden manager="plone.mainnavigation" skinname="Plone Default">
    <viewlet name="plone.global_sections" />
  </hidden>

  <!-- plone.pageletlayout.breadcrumbs -->
  <hidden manager="plone.abovecontent" skinname="Plone Default">
    <viewlet name="plone.path_bar" />
  </hidden>

  <!-- plone.pageletlayout.socialtags -->
  <hidden manager="plone.abovecontenttitle" skinname="Plone Default">
    <viewlet name="plone.socialtags" />
  </hidden>

  <!-- plone.pageletlayout.byline -->
  <hidden manager="plone.belowcontenttitle" skinname="Plone Default">
    <viewlet name="plone.documentbyline" />
  </hidden>

  <!-- plone.pageletlayout.colophon / .siteactions. CMFPlone's own profile
       already hides these two (it moved them into footer portlets), so this
       is belt and braces — it keeps them off a site that unhid them. -->
  <hidden manager="plone.portalfooter" skinname="Plone Default">
    <viewlet name="plone.colophon" />
    <viewlet name="plone.site_actions" />
  </hidden>
</object>
