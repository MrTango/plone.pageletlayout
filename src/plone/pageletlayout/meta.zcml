<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:meta="http://namespaces.zope.org/meta">

  <meta:directives namespace="http://namespaces.plone.org/plone">

    <!-- Five-compatible pagelet registration. Optional class, inline
         template=, multi-interface for= (gocept.pagelet prior art). -->
    <meta:directive
        name="pagelet"
        schema=".metadirectives.IPageletDirective"
        handler=".metaconfigure.pageletDirective"
        />

    <!-- Chrome pagelet: named IContentProvider + content template in one
         registration; rendered from layouts via provider:<name>. -->
    <meta:directive
        name="chromepagelet"
        schema=".metadirectives.IChromePageletDirective"
        handler=".metaconfigure.chromePageletDirective"
        />

    <!-- Like z3c:template / z3c:layout, but rendering through Zope's own
         (Five) template engine so provider: et al. work, and with
         multi-interface for=. -->
    <meta:directive
        name="template"
        schema=".metadirectives.ITemplateDirective"
        handler=".metaconfigure.templateDirective"
        />
    <meta:directive
        name="layout"
        schema=".metadirectives.ILayoutTemplateDirective"
        handler=".metaconfigure.layoutTemplateDirective"
        />

    <!-- Layout declaration: binds a layout name to a hand-written layout
         layer (plus an optional static view marker) as one IPageLayout
         named utility — the layout registry. Validated at config time. -->
    <meta:directive
        name="pagelayout"
        schema=".metadirectives.IPageLayoutDirective"
        handler=".metaconfigure.pageLayoutDirective"
        />

  </meta:directives>

</configure>
