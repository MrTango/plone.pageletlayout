<?xml version="1.0" encoding="UTF-8"?>
<registry>

  <!-- Which stock viewlet manager (slot) renders each layout element — see
       pagelets/slots.py. Mirrors slots.DEFAULT_ASSIGNMENTS; a theme adds or
       moves its own entries with <value purge="false">. -->
  <record name="plone.pageletlayout.slot_assignments">
    <field type="plone.registry.field.Dict">
      <title>Slot assignments</title>
      <description>Layout element name mapped to the viewlet manager it renders in.</description>
      <key_type type="plone.registry.field.TextLine" />
      <value_type type="plone.registry.field.TextLine" />
    </field>
    <value>
      <element key="plone.pageletlayout.logo">plone.portalheader</element>
      <element key="plone.pageletlayout.anontools">plone.portalheader</element>
      <element key="plone.pageletlayout.searchbox">plone.portalheader</element>
      <element key="plone.pageletlayout.globalnav">plone.mainnavigation</element>
      <element key="plone.pageletlayout.breadcrumbs">plone.abovecontent</element>
      <element key="plone.pageletlayout.socialtags">plone.abovecontenttitle</element>
      <element key="plone.pageletlayout.byline">plone.belowcontenttitle</element>
      <element key="plone.pageletlayout.siteactions">plone.portalfooter</element>
      <element key="plone.pageletlayout.copyright">plone.portalfooter</element>
      <element key="plone.pageletlayout.colophon">plone.portalfooter</element>
    </value>
  </record>

</registry>
