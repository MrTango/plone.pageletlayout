<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      lang="en"
      i18n:domain="plone.pageletlayout">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title tal:content="view/heading">Manage layout</title>
  <!-- resource-registry CSS only (no portal chrome, no scripts) so the
       component classes below render — see manage._StandalonePage. -->
  <tal:styles replace="structure view/styles" />
</head>
<body>
  <main class="plone-center plone-center--wide"
        tal:define="token view/token;
                    base string:${context/absolute_url}/@@${view/view_name}?_authenticator=${token};
                    action string:${context/absolute_url}/@@${view/view_name};
                    slot_names view/slot_names;
                    urls view/preview_urls">
    <div class="plone-stack" style="--plone-stack-space: var(--plone-space-m)">

      <h1 class="documentFirstHeading" tal:content="view/heading">Layout</h1>

      <p class="documentDescription" i18n:translate="">
        Order, visibility and slot of every viewlet in the page layout.
        Layout elements can move to another slot; stock viewlets stay in
        the manager they are registered for.
      </p>

      <p>
        <a href="${urls/managed}" target="_blank" i18n:translate="">Preview the layout</a>
      </p>


      <section tal:repeat="slot view/slots"
               tal:attributes="data-slot slot/name">
        <h2 tal:content="slot/label">portalheader</h2>
        <p tal:condition="not:slot/rows" class="text-muted" i18n:translate="">empty</p>
        <table class="table table-striped align-middle" tal:condition="slot/rows">
          <thead>
            <tr>
              <th i18n:translate="">Viewlet</th>
              <th i18n:translate="">State</th>
              <th i18n:translate="">Move</th>
              <th i18n:translate="">Visibility</th>
              <th i18n:translate="">Slot</th>
            </tr>
          </thead>
          <tbody>
            <tr tal:repeat="row slot/rows"
                tal:attributes="data-viewlet row/name;
                                class python:'text-muted' if row['hidden'] else None">
              <td>
                <strong tal:content="row/label">title</strong>
                <br />
                <small class="text-muted" tal:content="row/name">dotted.name</small>
              </td>
              <td>
                <span tal:condition="row/hidden"
                      class="badge bg-secondary" i18n:translate="">hidden</span>
                <span tal:condition="not:row/hidden"
                      class="badge bg-success" i18n:translate="">visible</span>
              </td>
              <td>
                <span class="plone-cluster" style="--plone-cluster-space: var(--plone-space-3xs)">
                  <a tal:condition="not:row/is_first"
                     class="btn btn-sm btn-outline-secondary"
                     href="${base}&action=up&manager=${slot/name}&viewlet=${row/name}"
                     title="Move up">&uarr;</a>
                  <a tal:condition="not:row/is_last"
                     class="btn btn-sm btn-outline-secondary"
                     href="${base}&action=down&manager=${slot/name}&viewlet=${row/name}"
                     title="Move down">&darr;</a>
                </span>
              </td>
              <td>
                <a tal:condition="row/hidden"
                   class="btn btn-sm btn-outline-primary"
                   href="${base}&action=show&manager=${slot/name}&viewlet=${row/name}"
                   i18n:translate="">show</a>
                <a tal:condition="not:row/hidden"
                   class="btn btn-sm btn-outline-warning"
                   href="${base}&action=hide&manager=${slot/name}&viewlet=${row/name}"
                   i18n:translate="">hide</a>
              </td>
              <td>
                <form tal:condition="row/is_element" method="get" action="${action}"
                      class="plone-cluster" style="--plone-cluster-space: var(--plone-space-3xs)">
                  <input type="hidden" name="_authenticator" value="${token}" />
                  <input type="hidden" name="action" value="assign" />
                  <input type="hidden" name="viewlet" value="${row/name}" />
                  <select name="slot" class="form-select form-select-sm"
                          aria-label="Slot" i18n:attributes="aria-label">
                    <option tal:repeat="name slot_names"
                            tal:attributes="value name;
                                            selected python:name == slot['name'] or None"
                            tal:content="name">plone.portalheader</option>
                    <option value="" i18n:translate="">(unassigned)</option>
                  </select>
                  <button type="submit" class="btn btn-sm btn-outline-secondary"
                          i18n:translate="">move</button>
                </form>
              </td>
            </tr>
          </tbody>
        </table>
      </section>

      <section tal:define="unassigned view/unassigned" tal:condition="unassigned">
        <h2 i18n:translate="">Unassigned elements</h2>
        <table class="table align-middle">
          <tbody>
            <tr tal:repeat="name unassigned" tal:attributes="data-viewlet name">
              <td tal:content="name">dotted.name</td>
              <td>
                <form method="get" action="${action}"
                      class="plone-cluster" style="--plone-cluster-space: var(--plone-space-3xs)">
                  <input type="hidden" name="_authenticator" value="${token}" />
                  <input type="hidden" name="action" value="assign" />
                  <input type="hidden" name="viewlet" value="${name}" />
                  <select name="slot" class="form-select form-select-sm"
                          aria-label="Slot" i18n:attributes="aria-label">
                    <option tal:repeat="slot_name slot_names"
                            tal:attributes="value slot_name"
                            tal:content="slot_name">plone.portalheader</option>
                  </select>
                  <button type="submit" class="btn btn-sm btn-outline-secondary"
                          i18n:translate="">assign</button>
                </form>
              </td>
            </tr>
          </tbody>
        </table>
      </section>

    </div>
  </main>
</body>
</html>
