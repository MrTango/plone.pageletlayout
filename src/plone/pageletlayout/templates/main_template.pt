<metal:page define-macro="master">
<tal:doctype replace="structure string:&lt;!DOCTYPE html&gt;" />

<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      tal:define="portal_state python:context.restrictedTraverse('@@plone_portal_state');
                  context_state python:context.restrictedTraverse('@@plone_context_state');
                  plone_view python:context.restrictedTraverse('@@plone');
                  icons python:context.restrictedTraverse('@@iconresolver');
                  plone_layout python:context.restrictedTraverse('@@plone_layout');
                  lang python:portal_state.language();
                  view nocall:view | nocall:plone_view;
                  dummy python:plone_layout.mark_view(view);
                  portal_url python:portal_state.portal_url();
                  checkPermission python:context.restrictedTraverse('portal_membership').checkPermission;
                  ajax_include_head python:request.get('ajax_include_head', False);
                  ajax_load python:False;
                  bridge python:context.restrictedTraverse('@@main_template');
                  layout_name bridge/layout_name;
                  dummy_deprecation python:bridge.warn_macro_use(template);
                  dummy_marked python:bridge.mark_request();"
      i18n:domain="plone"
      tal:attributes="lang lang;">

  <metal:cache tal:replace="structure provider:plone.httpheaders" />

<head>
  <meta charset="utf-8" />
  <tal:title replace="structure provider:plone.pageletlayout.htmltitle" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <tal:meta replace="structure provider:plone.pageletlayout.headmeta" />
  <tal:links replace="structure provider:plone.pageletlayout.headlinks" />

  <metal:topslot define-slot="top_slot" />
  <metal:headslot define-slot="head_slot" />

  <tal:styles replace="structure provider:plone.pageletlayout.styles" />
  <metal:styleslot define-slot="style_slot" />

  <tal:scripts replace="structure provider:plone.pageletlayout.scripts" />
  <metal:javascriptslot define-slot="javascript_head_slot" />

  <meta name="generator" content="Plone - https://plone.org/" />
</head>

<body tal:define="isRTL portal_state/is_rtl;
                  body_class python:'{} pagelet-layout-{}'.format(plone_layout.bodyClass(template, view), layout_name)"
      tal:attributes="class body_class;
                      dir python:isRTL and 'rtl' or 'ltr';
                      python:context.restrictedTraverse('@@plone_patterns_settings')()">

  <!-- toolbar: foreign subsystem, self-gating (as in layout.pt) -->
  <tal:toolbar replace="structure provider:plone.toolbar" />

  <!-- The slot frame, the twin of the pagelet page region
       (pagelets/templates/pagelayout.pt): the stock viewlet managers in
       header, main and footer, with the layout elements assigned to them.
       Every classic slot lands inside the element-body wrapper.
       The slot names inside the body mirror the classic master exactly
       (content > content macro > body > main > title/description/
       content-core), so consumer fills bind unchanged; prefs_main_template
       binds the nested content macro too. -->
  <div class="plone-layout">
    <header id="portal-top" class="plone-region">
      <tal:slot replace="structure provider:plone.portaltop" />
      <tal:slot replace="structure provider:plone.portalheader" />
      <tal:slot replace="structure provider:plone.mainnavigation" />
    </header>

    <main id="main-container" class="plone-region">
      <tal:messages replace="structure provider:plone.pageletlayout.statusmessages" />
      <metal:statusslot define-slot="global_statusmessage" />
      <tal:slot replace="structure provider:plone.abovecontent" />

      <div class="element-body">
      <metal:block define-slot="content">
      <metal:content define-macro="content">
        <metal:slot define-slot="body">
          <article id="content">
            <metal:bodytext define-slot="main">

              <header class="element-contentheader">
                <tal:slot replace="structure provider:plone.abovecontenttitle" />
                <metal:title define-slot="content-title">
                  <h1 tal:replace="structure context/@@title" />
                </metal:title>
                <tal:slot replace="structure provider:plone.belowcontenttitle" />
                <metal:description define-slot="content-description">
                  <p tal:replace="structure context/@@description" />
                </metal:description>
                <tal:slot replace="structure provider:plone.belowcontentdescription" />
              </header>

              <tal:slot replace="structure provider:plone.abovecontentbody" />
              <div id="content-core">
                <metal:text define-slot="content-core" tal:content="nothing">
                  Page body text
                </metal:text>
              </div>
              <tal:slot replace="structure provider:plone.belowcontentbody" />

            </metal:bodytext>
            <footer class="plone-region"
                    tal:define="below provider:plone.belowcontent"
                    tal:condition="python:below.strip()"
                    tal:content="structure below">below content</footer>
          </article>
        </metal:slot>
      </metal:content>
      </metal:block>
      </div>
    </main>

    <footer id="portal-footer-wrapper" class="plone-region">
      <tal:slot replace="structure provider:plone.portalfooter" />
    </footer>
  </div>

  <!-- Diazo off — strictly AFTER the styles provider rendered, or
       Barceloneta's production-css drops out of the head (the
       PageletPage.__call__ rule; here document order stands in for
       post-render). -->
  <tal:themeoff define="dummy2 python:request.response.setHeader('X-Theme-Disabled', '1')" />
  <tal:unmark define="dummy3 python:bridge.unmark_request()" />

</body>
</html>

</metal:page>
