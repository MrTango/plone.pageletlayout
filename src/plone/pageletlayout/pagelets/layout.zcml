<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plone.pageletlayout">

  <!-- ======================================================================
       The whole-body, one-manager layout. See layout.py.
       ====================================================================== -->

  <!-- 1. The ONE whole-body manager: a stock OrderedViewletManager (reused,
       not subclassed) holding every visible element. Default order:
       profiles/default/viewlets.xml. -->
  <browser:viewletManager
      name="plone.pageletlayout.layout"
      provides=".layout.ILayoutManager"
      class="plone.app.viewletmanager.manager.OrderedViewletManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />

  <!-- The 13 wrappers: ONE class (.layout.PageletViewlet), parameterized per
       registration by pagelet="..."; viewlet name == pagelet name (the body
       wraps the stock "pagelet" provider via chrome pagelet body). -->
  <browser:viewlet name="plone.pageletlayout.logo" pagelet="plone.pageletlayout.logo"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.anontools" pagelet="plone.pageletlayout.anontools"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.globalnav" pagelet="plone.pageletlayout.globalnav"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.searchbox" pagelet="plone.pageletlayout.searchbox"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.breadcrumbs" pagelet="plone.pageletlayout.breadcrumbs"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.statusmessages" pagelet="plone.pageletlayout.statusmessages"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.socialtags" pagelet="plone.pageletlayout.socialtags"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.contentheader" pagelet="plone.pageletlayout.contentheader"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.byline" pagelet="plone.pageletlayout.byline"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.body" pagelet="plone.pageletlayout.body"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.copyright" pagelet="plone.pageletlayout.copyright"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.colophon" pagelet="plone.pageletlayout.colophon"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />
  <browser:viewlet name="plone.pageletlayout.siteactions" pagelet="plone.pageletlayout.siteactions"
      class=".layout.PageletViewlet" manager=".layout.ILayoutManager"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer" permission="zope2.View" />

  <!-- 2. The single provider point: the managed whole-body manager. -->
  <plone:chromepagelet
      name="plone.pageletlayout.pagelayout"
      class=".layout.ManagedLayoutRegionChromePagelet"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      />

  <!-- 3. THE pagelet layout: one published view (pagelet_view) per content
       type, sharing ONE shell (templates/layout.pt, registered once at the
       bottom). Each stanza is one-stroke: inline template= registers the
       body-only content template for the class. The FTI default_view flips
       to pagelet_view (profiles/default/types/). -->

  <!-- Document -->
  <plone:pagelet
      name="pagelet_view"
      class=".layout.LayoutDocumentPagelet"
      template="templates/document.pt"
      for="plone.app.contenttypes.interfaces.IDocument"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />

  <!-- The five remaining default per-item types (ticket 11) -->
  <plone:pagelet
      name="pagelet_view"
      class=".layout.LayoutNewsItemPagelet"
      template="templates/newsitem.pt"
      for="plone.app.contenttypes.interfaces.INewsItem"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />
  <plone:pagelet
      name="pagelet_view"
      class=".layout.LayoutEventPagelet"
      template="templates/event.pt"
      for="plone.event.interfaces.IEvent"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />
  <plone:pagelet
      name="pagelet_view"
      class=".layout.LayoutFilePagelet"
      template="templates/file.pt"
      for="plone.app.contenttypes.interfaces.IFile"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />
  <plone:pagelet
      name="pagelet_view"
      class=".layout.LayoutImagePagelet"
      template="templates/image.pt"
      for="plone.app.contenttypes.interfaces.IImage"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />
  <plone:pagelet
      name="pagelet_view"
      class=".layout.LayoutLinkPagelet"
      template="templates/link.pt"
      for="plone.app.contenttypes.interfaces.ILink"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />

  <!-- ======================================================================
       Folderish listing views (ticket 12): the shared listing / summary /
       tabular / full / album formats. ONE stanza per FORMAT: multi-`for`
       registers each for Folder, Collection (the collection behaviour) AND
       the site root (whose old siteroot_listing folds in here). The FTI
       already defaults Folder/Collection to listing_view; these registrations
       shadow the stock @@listing_view etc. on our layer so the Display menu
       drives the pagelet layout. profiles flip only the site root
       (Plone_Site.xml).
       ====================================================================== -->
  <plone:pagelet
      name="listing_view"
      class=".layout.LayoutListingPagelet"
      template="templates/listing.pt"
      for="plone.app.contenttypes.interfaces.IFolder
           plone.app.contenttypes.behaviors.collection.ISyndicatableCollection
           plone.base.interfaces.IPloneSiteRoot"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />
  <plone:pagelet
      name="summary_view"
      class=".layout.LayoutSummaryPagelet"
      template="templates/summary.pt"
      for="plone.app.contenttypes.interfaces.IFolder
           plone.app.contenttypes.behaviors.collection.ISyndicatableCollection
           plone.base.interfaces.IPloneSiteRoot"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />
  <plone:pagelet
      name="tabular_view"
      class=".layout.LayoutTabularPagelet"
      template="templates/tabular.pt"
      for="plone.app.contenttypes.interfaces.IFolder
           plone.app.contenttypes.behaviors.collection.ISyndicatableCollection
           plone.base.interfaces.IPloneSiteRoot"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />
  <plone:pagelet
      name="full_view"
      class=".layout.LayoutFullPagelet"
      template="templates/full.pt"
      for="plone.app.contenttypes.interfaces.IFolder
           plone.app.contenttypes.behaviors.collection.ISyndicatableCollection
           plone.base.interfaces.IPloneSiteRoot"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />
  <plone:pagelet
      name="album_view"
      class=".layout.LayoutAlbumPagelet"
      template="templates/album.pt"
      for="plone.app.contenttypes.interfaces.IFolder
           plone.app.contenttypes.behaviors.collection.ISyndicatableCollection
           plone.base.interfaces.IPloneSiteRoot"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="zope2.View"
      />

  <!-- ======================================================================
       folder_contents: the pattern-driven management UI as a FULL-SCREEN
       pagelet (the docs/directives.md recipe, shipped). The stanza's
       provides= puts the IFullScreenPagelet marker on the published view —
       a trigger only: the trigger chain (layouts.py) sees it and applies
       the fullscreen layout layer, where the region shadow below lives.
       Shadows the stock browser:page (plone.app.content) on our layer;
       for= is the stock registration's own IFolderish, so the site root is
       covered too.
       ====================================================================== -->
  <plone:pagelet
      name="folder_contents"
      class=".layout.LayoutFolderContentsPagelet"
      template="templates/folder_contents.pt"
      provides="plone.pageletlayout.interfaces.IFullScreenPagelet"
      for="Products.CMFCore.interfaces._content.IFolderish"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      permission="cmf.ListFolderContents"
      />

  <!-- The fullscreen layout's variant: on requests carrying the fullscreen
       layout layer, the page region is body-only. The layer dimension (not
       view=): a layout layer more specific than the package browser layer
       beats every shipped registration, and registering once on the layer
       serves the static marker AND ?pagelet_layout=fullscreen (the one
       migration in docs/request-layouts.md, section 10). -->
  <plone:chromepagelet
      name="plone.pageletlayout.pagelayout"
      class=".layout.BodyOnlyRegion"
      layer="plone.pageletlayout.interfaces.IFullscreenLayoutLayer"
      />

  <!-- The shared shell: ONE layout template for all twelve published
       pagelets. Registered standalone (there is deliberately no inline
       layout= — the frame is the site's to provide, not the pagelet's to
       declare); the body-only content templates ride inline on the pagelet
       stanzas above. -->
  <plone:layout
      template="templates/layout.pt"
      for=".layout.LayoutDocumentPagelet
           .layout.LayoutNewsItemPagelet
           .layout.LayoutEventPagelet
           .layout.LayoutFilePagelet
           .layout.LayoutImagePagelet
           .layout.LayoutLinkPagelet
           .layout.LayoutListingPagelet
           .layout.LayoutSummaryPagelet
           .layout.LayoutTabularPagelet
           .layout.LayoutFullPagelet
           .layout.LayoutAlbumPagelet
           .layout.LayoutFolderContentsPagelet"
      layer="plone.pageletlayout.interfaces.IPlonePageletlayoutLayer"
      />

</configure>
