<div class="plone-stack"
     xmlns:tal="http://xml.zope.org/namespaces/tal"
     xmlns:metal="http://xml.zope.org/namespaces/metal"
     xmlns:i18n="http://xml.zope.org/namespaces/i18n"
     i18n:domain="plone"
     tal:define="portal context/@@plone_portal_state/portal;
                 mailhost_is_configured view/mailhost_is_configured">

  <!-- The page heading (a framed page's content header is shadowed empty)
       and, for the modal, the h1 pat-plone-modal lifts out as its title. -->
  <h1 class="documentFirstHeading" i18n:translate="heading_contact_form">Contact form</h1>

  <p class="documentDescription"
     tal:condition="portal/description"
     tal:content="portal/description">Site Description</p>

  <p tal:condition="not:mailhost_is_configured" i18n:translate="text_no_email_setup">
    This site doesn't have a valid email setup, so you cannot use
    any contact forms.
  </p>

  <tal:form condition="python: mailhost_is_configured and not view.success">
    <p class="documentDescription" i18n:translate="description_contact_site_owner">
      Fill in this form to contact the site owners.
    </p>
    <!-- The stock #content-core wrapper around the form is dropped: the
         framed body element already emits that id. -->
    <form metal:use-macro="context/@@ploneform-macros/titlelessform"></form>
  </tal:form>

  <p tal:condition="view/success"
     class="documentDescription"
     i18n:translate="description_contact_site_owner_success">
    Thank you for your feedback
  </p>

</div>
