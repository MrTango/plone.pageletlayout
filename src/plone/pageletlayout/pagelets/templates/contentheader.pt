<header class="element-contentheader" i18n:domain="plone">
  <tal:above-title replace="structure view/above_title" />
  <h1 class="documentFirstHeading"
      tal:content="view/context/Title">context title</h1>
  <tal:below-title replace="structure view/below_title" />
  <p class="documentDescription"
     tal:define="description view/context/Description"
     tal:condition="description"
     tal:content="description">context description</p>
  <tal:below-description replace="structure view/below_description" />
</header>
