<tal:forced-password-change
    xmlns:tal="http://xml.zope.org/namespaces/tal"
    xmlns:metal="http://xml.zope.org/namespaces/metal"
    xmlns:i18n="http://xml.zope.org/namespaces/i18n"
    i18n:domain="plone">

  <h1 class="documentFirstHeading"
      i18n:translate="heading_change_password">Time to change your password!</h1>

  <div class="documentDescription description">
    <span i18n:translate="description_forced_password_change">
      Before you continue, you need to change your password.
    </span>
  </div>

  <div id="content-core">
    <metal:form use-macro="context/@@ploneform-macros/titlelessform" />
  </div>
</tal:forced-password-change>
