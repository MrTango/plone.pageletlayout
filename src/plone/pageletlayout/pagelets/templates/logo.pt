<a id="portal-logo"
   class="element-logo"
   title="Home"
   tal:attributes="href view/navigation_root_url;
                   title view/navigation_root_title"
   i18n:attributes="title"
   i18n:domain="plone">
  <img alt=""
       src="plone-logo.svg"
       tal:attributes="src view/img_src" />
  <span class="plone-site-title"
        tal:content="view/logo_title">Site title</span>
</a>
