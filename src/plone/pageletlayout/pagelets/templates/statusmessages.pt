<aside class="element-statusmessages" id="global_statusmessage"
       xmlns:tal="http://xml.zope.org/namespaces/tal"
       xmlns:i18n="http://xml.zope.org/namespaces/i18n"
       i18n:domain="plone">
  <tal:messages define="icons nocall:context/@@iconresolver"
                repeat="message view/messages">
    <div class="portalMessage alert ${python:display_info['cssclass']}"
         role="alert"
         tal:define="mtype message/type | nothing;
                     display_info python:view.display_info_for_mtype(mtype)"
         tal:condition="mtype">
      <tal:icon replace="structure python:icons.tag(display_info['icon'], tag_alt=display_info['msg'], tag_class='statusmessage-icon')" />
      <strong>${python:display_info['msg']}</strong>
      <span class="content"
            tal:replace="message/message | nothing"
            i18n:translate="">The status message.</span>
    </div>
  </tal:messages>
</aside>
