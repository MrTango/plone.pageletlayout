<form class="searchPage pat-formautofocus pat-search plone-stack"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      i18n:domain="plone"
      id="searchform"
      name="searchform"
      action="@@search"
      role="search"
      tal:define="b_start python:0;
                  b_start request/b_start | b_start;
                  batch python: view.results(b_start=b_start);
                  portal context/@@plone_portal_state/portal;
                  first_call not:request/advanced_search|nothing;
                  st python:request.get('SearchableText', '');
                  DateTime python:modules['DateTime'].DateTime;
                  navigation_root_url view/navroot_url;
                  icons python:context.restrictedTraverse('@@iconresolver');">

  <!-- pat-search (@plone/mockup) drives this whole page from the ids below:
       it refetches the same URL with ajax_load=1 and swaps #search-results,
       #search-term and #results-count in by id. Renaming any of them, or the
       hidden inputs it writes into, breaks sorting/filtering/pagination. -->
  <input type="hidden" name="sort_on" value="" />
  <input type="hidden" name="sort_order" value="" />
  <input type="hidden" id="search-batch-start" name="b_start:int" value="${request/b_start|string:0}" />
  <input type="hidden" id="advanced-search-input" name="advanced_search" value="${python: 'True' if view.show_advanced_search() else 'False'}" />
  <input type="hidden" name="created.range:record" value="min" />

  <div class="input-group">
    <input class="searchPage form-control"
           name="SearchableText"
           type="text"
           size="25"
           title="Search Site"
           value="${st}"
           i18n:attributes="title title_search_title;" />
    <button class="searchPage allowMultiSubmit btn btn-primary"
            type="submit"
            i18n:translate="label_search">Search</button>
  </div>

  <h1 class="documentFirstHeading" id="search-term">
    <span tal:condition="not:st" i18n:translate="">Search results</span>
    <span tal:condition="st" i18n:translate="">
      Search results for
      <span class="discreet" tal:content="st" i18n:name="term">Search Term</span>
    </span>
  </h1>

  <div class="search-toolbar plone-cluster"
       style="--plone-cluster-justify: space-between; --plone-cluster-space: var(--plone-space-m)">

    <span i18n:translate="batch_x_items_matching_your_criteria" id="results-count">
      <span i18n:name="number"
            id="search-results-number"
            tal:content="batch/sequence_length|string:0">234</span>
      items matching your search terms.
    </span>

    <div class="search-controls plone-cluster">

      <div class="nav-item dropdown" id="search-filter">
        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button"
           aria-expanded="false" id="search-filter-toggle"
           i18n:translate="narrow_search_options">Filter the results</a>
        <div class="dropdown-menu dropdown-menu-md-end">
          <div class="plone-cluster"
               style="--plone-cluster-align: flex-start; --plone-cluster-space: var(--plone-space-m)">

            <div class="search-facet plone-stack" style="--plone-stack-space: var(--plone-space-3xs)">
              <strong i18n:translate="label_item_type">Item type</strong>
              <ul class="search-type-options plone-stack"
                  style="--plone-stack-space: var(--plone-space-3xs)"
                  tal:define="portal_types portal/portal_types;
                              types_list view/types_list;
                              all_checked python:(len(types_list) == len(request.get('portal_type', []))) or first_call">
                <li>
                  <div class="form-check">
                    <input type="checkbox"
                           name="pt_toggle"
                           value="#"
                           id="pt_toggle"
                           class="form-check-input"
                           checked="${python:'checked' if all_checked else ''}" />
                    <label for="pt_toggle" class="form-check-label"
                           i18n:translate="label_toggle">Select All/None</label>
                  </div>
                </li>
                <li tal:repeat="type types_list">
                  <div class="form-check">
                    <input type="checkbox" name="portal_type:list" class="form-check-input"
                           value="${type}" id="portal_type_${repeat/type/number}"
                           checked="${python:'checked' if ((type in request.get('portal_type', [])) or first_call) else ''}" />
                    <label for="portal_type_${repeat/type/number}" i18n:translate="" class="form-check-label"
                           tal:content="python: portal_types.getTypeInfo(type).Title()" />
                  </div>
                </li>
              </ul>
            </div>

            <div class="search-facet plone-stack" style="--plone-stack-space: var(--plone-space-3xs)">
              <strong i18n:translate="label_new_items_since">New items since</strong>
              <ul class="search-date-options plone-stack"
                  style="--plone-stack-space: var(--plone-space-3xs)"
                  tal:define="today python:DateTime().earliestTime();
                              yesterday python:(today-1).ISO();
                              lastweek python:(today-7).ISO();
                              lastmonth python:(today-31).ISO();
                              ever python:DateTime('1970-01-02').ISO();
                              checked python:request.get('created', {}).get('query', ever)">
                <li>
                  <div class="form-check">
                    <input type="radio" id="query-date-yesterday" name="created.query:record:date" class="form-check-input"
                           value="${yesterday}" checked="${python:'checked' if checked==yesterday else ''}" />
                    <label for="query-date-yesterday" i18n:translate="time_yesterday" class="form-check-label">Yesterday</label>
                  </div>
                </li>
                <li>
                  <div class="form-check">
                    <input type="radio" id="query-date-lastweek" name="created.query:record:date" class="form-check-input"
                           value="${lastweek}" checked="${python:'checked' if checked==lastweek else ''}" />
                    <label for="query-date-lastweek" i18n:translate="time_last_week" class="form-check-label">Last week</label>
                  </div>
                </li>
                <li>
                  <div class="form-check">
                    <input type="radio" id="query-date-lastmonth" name="created.query:record:date" class="form-check-input"
                           value="${lastmonth}" checked="${python:'checked' if checked==lastmonth else ''}" />
                    <label for="query-date-lastmonth" i18n:translate="time_last_month" class="form-check-label">Last month</label>
                  </div>
                </li>
                <li>
                  <div class="form-check">
                    <input type="radio" id="query-date-ever" name="created.query:record:date" class="form-check-input"
                           value="${ever}" checked="${python:'checked' if checked==ever else ''}" />
                    <label for="query-date-ever" i18n:translate="time_ever" class="form-check-label">Ever</label>
                  </div>
                </li>
              </ul>
            </div>

          </div>
        </div>
      </div>

      <div class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button"
           aria-expanded="false" i18n:translate="sort_by">Sort by</a>
        <ul class="dropdown-menu dropdown-menu-md-end" id="sorting-options">
          <li tal:repeat="item view/sort_options">
            <a class="dropdown-item" href="${item/url}"
               data-sort="${item/sortkey}" data-order="${python:'reverse' if item.reverse else ''}"
               tal:content="item/title">sort option</a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <div id="search-results-wrapper">
    <div id="search-results"
         class="plone-stack"
         tal:define="show_images python:view.show_images;
                     search_image_scale python:view.search_image_scale;"
         data-default-sort="${python:request.get('sort_on') or view.default_sort_on}">

      <div class="alert alert-info"
           tal:condition="not: batch"
           i18n:translate="description_no_results_found">No results were found.</div>

      <tal:results tal:condition="batch"
                   tal:define="isAnon context/@@plone_portal_state/anonymous;
                               toLocalizedTime nocall: context/@@plone/toLocalizedTime;
                               use_view_action python:context.portal_registry.get('plone.types_use_view_action_in_listings', []);
                               allowAnonymousViewAbout python:context.portal_registry['plone.allow_anon_views_about'];
                               show_about python:not isAnon or allowAnonymousViewAbout;
                               image_scale portal/@@image_scale;
                               is_rtl context/@@plone_portal_state/is_rtl">

        <!-- The site's shared listing markup (.entries/.item/.url — the same
             hooks listing.pt emits), so a result row reads like every other
             listed item. The stock Bootstrap .list-group and its numbering
             are gone with the utility soup. -->
        <div class="entries searchResults">
          <article class="item" tal:repeat="item batch">
            <div class="plone-sidebar"
                 tal:define="item_url item/getURL;
                             item_type item/PortalType;
                             item_link python:(item_url + '/view') if item_type in use_view_action else item_url;
                             has_image item/getIcon">

              <div class="plone-sidebar__main plone-stack"
                   style="--plone-stack-space: var(--plone-space-2xs)">

                <a class="url state-${item/review_state}"
                   href="${item_link}"
                   tal:content="python:item.getDataOrigin().pretty_title_or_id()">Item title</a>

                <p class="documentByline" tal:condition="show_about">
                  <span class="documentAuthor" i18n:translate="label_by_author">
                    by
                    <tal:block tal:condition="item/Creator"
                               tal:define="author python:context.portal_membership.getMemberInfo(item.Creator())">
                      <a href="${navigation_root_url}/author/${item/Creator}"
                         tal:content="python:author and author['fullname'] or item.Creator()"
                         tal:omit-tag="not:item/Creator"
                         i18n:name="author">Bob Dobalina</a>
                    </tal:block>
                  </span>
                  <span tal:define="publication_date item/EffectiveDate;
                                    modification_date item/ModificationDate">
                    <span class="documentPublished" tal:condition="python: publication_date != 'None'">
                      &mdash;
                      <span i18n:translate="box_published">published</span>
                      <span tal:replace="python:toLocalizedTime(publication_date, long_format=0)">August 16, 2001</span>
                    </span>
                    <span class="documentModified" tal:condition="python: modification_date != publication_date">
                      &mdash;
                      <span i18n:translate="box_last_modified">last modified</span>
                      <span tal:replace="python:toLocalizedTime(modification_date, long_format=1)">August 16, 2001</span>
                    </span>
                  </span>
                  <span tal:define="categories item/Subject|nothing" tal:condition="categories">
                    &mdash;
                    <tal:filedunder i18n:translate="">filed under:</tal:filedunder>
                    <span tal:repeat="category categories">
                      <a href="${navigation_root_url}/@@search?Subject%3Alist=${category}"
                         class="link-category" rel="tag"
                         tal:content="category">Category</a><tal:separator condition="not: repeat/category/end">,</tal:separator>
                    </span>
                  </span>
                </p>

                <p class="croppedDescription description"
                   tal:condition="item/CroppedDescription"
                   tal:content="item/CroppedDescription">Cropped description</p>

                <cite class="documentByline searchLocation"
                      tal:define="breadcrumbs python: view.breadcrumbs(item)"
                      tal:condition="breadcrumbs">
                  <span i18n:translate="text_searchitem_location">Located in</span>
                  <span dir="${python:'rtl' if is_rtl else 'ltr'}" tal:repeat="crumb breadcrumbs">
                    <tal:item tal:define="is_last repeat/crumb/end;
                                          url crumb/absolute_url;
                                          title crumb/Title">
                      <a href="${url}" tal:omit-tag="not: url" tal:content="title">crumb</a>
                      <span class="breadcrumbSeparator" tal:condition="not: is_last">/</span>
                    </tal:item>
                  </span>
                </cite>

              </div>

              <a class="plone-sidebar__aside"
                 href="${item_link}"
                 tal:condition="python: show_images and has_image">
                <img tal:replace="structure python: image_scale.tag(item, 'image', scale=search_image_scale, css_class='image-responsive thumb-icon')" />
              </a>

            </div>
          </article>
        </div>

        <nav metal:use-macro="context/batch_macros/macros/navigation"></nav>

      </tal:results>
    </div>
  </div>

  <div id="rss-subscription"
       tal:condition="context/@@syndication-util/search_rss_enabled">
    <a class="plone-cluster"
       style="--plone-cluster-space: var(--plone-space-3xs)"
       href="${context/@@plone_context_state/object_url}/search_rss?${request/QUERY_STRING}">
      <img tal:replace="structure python:icons.tag('rss-fill')" />
      <span i18n:translate="title_subscribe_rss_feed">Subscribe to an always-updated RSS feed.</span>
    </a>
  </div>

</form>
