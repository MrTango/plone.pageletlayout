<tal:doctype replace="structure string:&lt;!DOCTYPE html&gt;" />
<html tal:define="portal_state python:context.restrictedTraverse('@@plone_portal_state');
                  plone_layout python:context.restrictedTraverse('@@plone_layout');
                  dummy python:plone_layout.mark_view(view);
                  isRTL portal_state/is_rtl;"
      tal:attributes="lang portal_state/language">
<head>
  <meta charset="utf-8" />
  <tal:title replace="structure provider:plone.pageletlayout.htmltitle" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <tal:meta replace="structure provider:plone.pageletlayout.headmeta" />
  <tal:links replace="structure provider:plone.pageletlayout.headlinks" />
  <tal:styles replace="structure provider:plone.pageletlayout.styles" />
  <tal:scripts replace="structure provider:plone.pageletlayout.scripts" />
  <meta name="generator" content="Plone - https://plone.org/" />
</head>
<body tal:define="body_class python:plone_layout.bodyClass(template, view)"
      tal:attributes="class body_class;
                      dir python:isRTL and 'rtl' or 'ltr';
                      python:context.restrictedTraverse('@@plone_patterns_settings')()">

  <!-- toolbar: the only exception — foreign subsystem, self-gating -->
  <tal:toolbar replace="structure provider:plone.toolbar" />

  <!-- The single layout container: a named-column grid (see section 4 of the
       theming architecture). Its direct children are the layout elements, each
       landing in the readable content column unless it opts into .plone-bleed.
       Vertical rhythm is the grid's row-gap (plone-layout-space token). No
       Bootstrap .container, no .row/.col: the primitive owns measure,
       centering, and gutters through clara tokens. -->
  <div class="plone-layout">
    <!-- THE single provider point: the managed whole-body manager, resolved
         from one provider name. -->
    <tal:layout replace="structure provider:plone.pageletlayout.pagelayout" />
  </div>

</body>
</html>
