<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plonetheme.pageletbase">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />

  <genericsetup:registerProfile
      name="default"
      title="Plonetheme Pagelet Base"
      description="A Plone theme base for themes based on pagelets"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Plonetheme Pagelet Base (uninstall)"
      description="Uninstalls plonetheme.pageletbase"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <genericsetup:importStep
      name="plonetheme.pageletbase-uninstall"
      title="Plonetheme Pagelet Base uninstall"
      description="Uninstall plonetheme.pageletbase"
      handler="plonetheme.pageletbase.setuphandlers.uninstall"
      />

</configure>
